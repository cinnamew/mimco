  - m_Id: 984483895664640
    m_Localized: "<b>hecho por...</b>\n> <b>cinnamew:</b> c\xF3digo/di\xE1logos/historia\n>
      <b>effixs:</b> arte de los minijuegos\n> <b>pocketnii:</b> UI/otros artes/historia\n>
      <b>spiderface721:</b> c\xF3digo de los minijuegos\n(\xA1la m\xFAsica no es
      nuestra!)\n\nsi te gust\xF3 el juego no olvides dejarnos un comentario/calificaci\xF3n
      :) \xA1tambi\xE9n hay una secuela as\xED que puedes darle un vistazo!"
    m_Metadata:
      m_Items: []
